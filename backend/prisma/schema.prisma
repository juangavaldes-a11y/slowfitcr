generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WebhookStatus {
  PROCESSED
  FAILED
}

enum InventoryReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DeliveryStatus {
  QUOTED
  PAYMENT_PENDING
  READY_TO_DISPATCH
  DISPATCHING
  ACTIVE
  COMPLETED
  CANCELLED
  FAILED
}

enum PreorderStatus {
  DEPOSIT_PAID
  STOCK_AVAILABLE
  FINAL_PAYMENT_PENDING
  COMPLETE
}

model Product {
  id          String          @id @default(uuid())
  handle      String          @unique
  title       String
  description String          @default("")
  status      ProductStatus   @default(DRAFT)
  published   Boolean         @default(false)
  preorderEnabled Boolean     @default(false)
  tags        String[]        @default([])
  minPrice    Decimal         @default(0) @db.Decimal(12, 2)
  inventoryTotal Int          @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  variants    ProductVariant[]
  images      ProductImage[]
  metric      ProductMetric?
  customerFavorites CustomerFavorite[]

  @@index([status, updatedAt])
  @@index([title])
  @@index([minPrice])
  @@index([inventoryTotal])
  @@index([tags], type: Gin)
}

model ProductMetric {
  productId         String   @id
  searchImpressions Int      @default(0)
  clicks            Int      @default(0)
  unitsSold         Int      @default(0)
  revenue           Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt         DateTime @updatedAt
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([searchImpressions])
  @@index([clicks])
  @@index([unitsSold])
}

model ProductVariant {
  id                String   @id @default(uuid())
  productId         String
  title             String
  size              String?
  color             String?
  colorHex          String?
  sku               String?  @unique
  price             Decimal  @db.Decimal(12, 2)
  compareAtPrice    Decimal? @db.Decimal(12, 2)
  inventoryQuantity Int      @default(0)
  position          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  altText   String   @default("")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model Customer {
  id                  String   @id @default(uuid())
  email               String   @unique
  passwordHash        String
  firstName           String
  lastName            String?
  locale              String   @default("es")
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  favorites           CustomerFavorite[]
  cart                CustomerCart?
}

model CustomerFavorite {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([customerId, createdAt])
}

model CustomerCart {
  id         String   @id @default(uuid())
  customerId String   @unique
  lines      Json
  cartId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  customerId String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt])
}

model Order {
  id                String    @id @default(uuid())
  externalPaymentId String    @unique
  finalPaymentReference String? @unique
  orderNumber    String?
  name           String?
  email          String
  financialStatus String?
  fulfillmentStatus String?
  total          String?
  currency       String?
  items          Json
  preorderStatus PreorderStatus?
  depositPaidAmount String?
  totalOrderAmount String?
  paymentCreatedAt DateTime?
  inventoryAdjustedAt DateTime?
  updatedAt      DateTime   @updatedAt
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  delivery       Delivery?

  @@index([email])
  @@index([customerId, updatedAt])
}

model Delivery {
  id                 String         @id @default(uuid())
  orderId            String?        @unique
  paymentReference   String?        @unique
  provider           String
  status             DeliveryStatus @default(QUOTED)
  externalQuoteId    String
  externalDeliveryId String?        @unique
  feeMinor           Int
  currency           String
  quoteExpiresAt     DateTime
  pickup             Json
  dropoff            Json
  contact            Json
  manifest           Json
  dropoffEta         DateTime?
  trackingUrl        String?
  rawQuote           Json?
  rawDelivery        Json?
  errorMessage       String?
  approvedAt         DateTime?
  dispatchedAt       DateTime?
  completedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  order              Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([provider, createdAt])
}

model Review {
  id            String       @id @default(uuid())
  productHandle String
  locale        String
  rating        Int
  author        String
  email         String?
  content       String
  status        ReviewStatus @default(PENDING)
  source        String       @default("manual")
  createdAt     DateTime     @default(now())
  moderatedAt   DateTime?
  moderatedBy   String?

  @@index([productHandle, locale, status])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actor     String
  details   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model AdminUser {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String
  displayName     String
  role            String   @default("operator")
  totpSecret      String?
  active          Boolean  @default(true)
  failedAttempts  Int      @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active, role])
}

model PaymentWebhookEvent {
  id             String        @id @default(uuid())
  idempotencyKey String        @unique
  topic          String
  provider       String
  orderId        String?
  payload        Json
  status         WebhookStatus @default(PROCESSED)
  errorMessage   String?
  createdAt      DateTime      @default(now())
  processedAt    DateTime?
  replayedAt     DateTime?

  @@index([createdAt])
  @@index([topic])
  @@index([status])
}

model InventoryReservation {
  id             String                     @id @default(uuid())
  reference      String                     @unique
  status         InventoryReservationStatus @default(ACTIVE)
  lines          Json
  expiresAt      DateTime
  committedAt    DateTime?
  releasedAt     DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([status, expiresAt])
}

model OutboxEvent {
  id             String      @id @default(uuid())
  kind           String
  destination    String
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int         @default(0)
  availableAt    DateTime    @default(now())
  lockedAt       DateTime?
  deliveredAt    DateTime?
  lastError      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, availableAt])
  @@index([kind, createdAt])
}

model RateLimitBucket {
  id        String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

model InventorySettings {
  id                       String   @id @default("default")
  hkShippingUsd            Decimal  @default(0) @db.Decimal(14, 2)
  invoiceAdjustmentUsd     Decimal  @default(0) @db.Decimal(14, 2)
  fxRate                   Decimal? @db.Decimal(12, 4)
  crShippingUsd            Decimal? @db.Decimal(14, 2)
  nationalizationCrc       Decimal? @db.Decimal(14, 2)
  otherImportCrc           Decimal? @db.Decimal(14, 2)
  extraUnitCrc             Decimal  @default(0) @db.Decimal(14, 2)
  cardCommissionRate       Decimal  @default(0) @db.Decimal(6, 4)
  customizationPerPieceUsd Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt                DateTime @updatedAt
}

model InventoryLine {
  id                String          @id @default(uuid())
  code              String
  productName       String
  color             String
  productHandle     String?
  sizes             Json
  piecesPerGarment  Int             @default(1)
  unitPriceUsd      Decimal         @db.Decimal(12, 2)
  salePriceCrc      Decimal?        @db.Decimal(14, 2)
  supplierEquivalence String?
  position          Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  sales             InventorySale[]

  @@unique([code, color])
  @@index([productHandle])
}

model InventorySale {
  id            String        @id @default(uuid())
  lineId        String
  size          String
  quantity      Int
  unitPriceCrc  Decimal       @db.Decimal(14, 2)
  discountCrc   Decimal       @default(0) @db.Decimal(14, 2)
  soldAt        DateTime
  paymentMethod String
  source        String        @default("MANUAL")
  orderId       String?
  note          String        @default("")
  voidedAt      DateTime?
  refundedQuantity  Int       @default(0)
  restockedQuantity Int       @default(0)
  refundedAt    DateTime?
  createdAt     DateTime      @default(now())
  line          InventoryLine @relation(fields: [lineId], references: [id], onDelete: Restrict)

  @@unique([orderId, lineId, size])
  @@index([soldAt])
  @@index([lineId, voidedAt])
  @@index([paymentMethod])
}

model PaymentMethod {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model ExchangeRate {
  date      DateTime @id @db.Date
  buyRate   Decimal  @db.Decimal(12, 4)
  sellRate  Decimal  @db.Decimal(12, 4)
  source    String   @default("BCCR")
  fetchedAt DateTime @default(now())
}
