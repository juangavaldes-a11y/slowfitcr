generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WebhookStatus {
  PROCESSED
  FAILED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id          String          @id @default(uuid())
  handle      String          @unique
  title       String
  description String          @default("")
  status      ProductStatus   @default(DRAFT)
  tags        String[]        @default([])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  variants    ProductVariant[]
  images      ProductImage[]

  @@index([status, updatedAt])
}

model ProductVariant {
  id                String   @id @default(uuid())
  productId         String
  title             String
  sku               String?  @unique
  price             Decimal  @db.Decimal(12, 2)
  compareAtPrice    Decimal? @db.Decimal(12, 2)
  inventoryQuantity Int      @default(0)
  position          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  altText   String   @default("")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model Customer {
  id                  String   @id @default(uuid())
  email               String   @unique
  passwordHash        String
  firstName           String
  lastName            String?
  locale              String   @default("es")
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  customerId String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt])
}

model Order {
  id                String    @id @default(uuid())
  externalPaymentId String    @unique
  orderNumber    String?
  name           String?
  email          String
  financialStatus String?
  fulfillmentStatus String?
  total          String?
  currency       String?
  items          Json
  paymentCreatedAt DateTime?
  inventoryAdjustedAt DateTime?
  updatedAt      DateTime   @updatedAt
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([customerId, updatedAt])
}

model Review {
  id            String       @id @default(uuid())
  productHandle String
  locale        String
  rating        Int
  author        String
  email         String?
  content       String
  status        ReviewStatus @default(PENDING)
  source        String       @default("manual")
  createdAt     DateTime     @default(now())
  moderatedAt   DateTime?
  moderatedBy   String?

  @@index([productHandle, locale, status])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actor     String
  details   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model PaymentWebhookEvent {
  id             String        @id @default(uuid())
  idempotencyKey String        @unique
  topic          String
  provider       String
  orderId        String?
  payload        Json
  status         WebhookStatus @default(PROCESSED)
  errorMessage   String?
  createdAt      DateTime      @default(now())
  processedAt    DateTime?
  replayedAt     DateTime?

  @@index([createdAt])
  @@index([topic])
  @@index([status])
}
