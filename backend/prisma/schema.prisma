generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WebhookStatus {
  PROCESSED
  FAILED
}

model Customer {
  id                  String   @id @default(uuid())
  email               String   @unique
  passwordHash        String
  firstName           String
  lastName            String?
  locale              String   @default("es")
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  customerId String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt])
}

model Order {
  id             String    @id @default(uuid())
  shopifyOrderId String    @unique
  orderNumber    String?
  name           String?
  email          String
  financialStatus String?
  fulfillmentStatus String?
  total          String?
  currency       String?
  items          Json
  shopifyCreatedAt DateTime?
  updatedAt      DateTime   @updatedAt
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([customerId, updatedAt])
}

model Review {
  id            String       @id @default(uuid())
  productHandle String
  locale        String
  rating        Int
  author        String
  email         String?
  content       String
  status        ReviewStatus @default(PENDING)
  source        String       @default("manual")
  createdAt     DateTime     @default(now())
  moderatedAt   DateTime?
  moderatedBy   String?

  @@index([productHandle, locale, status])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actor     String
  details   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model OrderWebhookEvent {
  id             String        @id @default(uuid())
  idempotencyKey String        @unique
  topic          String
  shop           String
  orderId        String?
  payload        Json
  status         WebhookStatus @default(PROCESSED)
  errorMessage   String?
  createdAt      DateTime      @default(now())
  processedAt    DateTime?
  replayedAt     DateTime?

  @@index([createdAt])
  @@index([topic])
  @@index([status])
}
