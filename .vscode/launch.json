{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Slow Fit: dev server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev"
    },
    {
      "name": "Slow Fit: full stack",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s/es",
        "action": "debugWithChrome"
      }
    },
    {
      "name": "Slow Fit: open English route",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s/en",
        "action": "debugWithChrome"
      }
    }
  ]
}