{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Slow Fit: dev server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev"
    },
    {
      "name": "Slow Fit: Chrome (ES)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:3000/es",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Slow Fit: Chrome (EN)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:3000/en",
      "webRoot": "${workspaceFolder}"
    }
  ]
}